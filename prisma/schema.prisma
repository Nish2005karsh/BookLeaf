datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Category {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum AiState {
  PENDING
  DONE
  FAILED
  SKIPPED
}

enum MessageSender {
  AUTHOR
  ADMIN
}

enum AiCallKind {
  CLASSIFY
  DRAFT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  phone        String?
  city         String?
  joinedAt     DateTime?
  createdAt    DateTime  @default(now())

  books           Book[]
  tickets         Ticket[]        @relation("AuthorTickets")
  assignedTickets Ticket[]        @relation("AssignedAdminTickets")
  messages        TicketMessage[]
  internalNotes   InternalNote[]
}

model Book {
  id              String    @id @default(cuid())
  externalId      String    @unique // e.g. "BK001"
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  isbn            String?
  genre           String
  publicationDate DateTime?
  status          String    // e.g. "Published & Live", "In Production - Cover Design"
  mrp             Int?      // in rupees
  royaltyPerCopy  Int?      // in rupees
  copiesSold      Int       @default(0)
  royaltyEarned   Int       @default(0)
  royaltyPaid     Int       @default(0)
  royaltyPending  Int       @default(0)
  lastPayoutDate  DateTime?
  printPartner    String?
  availableOn     String[]  // array of platforms (e.g. Amazon India, Flipkart)

  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id                     String       @id @default(cuid())
  number                 Int          @default(autoincrement())
  authorId               String
  author                 User         @relation("AuthorTickets", fields: [authorId], references: [id], onDelete: Cascade)
  bookId                 String?
  book                   Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  subject                String
  description            String
  attachmentNames        String[]     @default([])
  category               Category?
  aiCategory             Category?
  priority               Priority?
  aiPriority             Priority?
  aiConfidence           Float?
  aiReason               String?
  categoryOverriddenById String?
  priorityOverriddenById String?
  aiState                AiState      @default(PENDING)
  status                 TicketStatus @default(OPEN)
  assignedToId           String?
  assignedTo             User?        @relation("AssignedAdminTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  draftResponse          String?
  draftGeneratedAt       DateTime?
  draftState             AiState      @default(PENDING)
  firstRespondedAt       DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  messages      TicketMessage[]
  internalNotes InternalNote[]
  aiCallLogs    AiCallLog[]

  @@index([status, priority, createdAt])
  @@index([authorId])
  @@index([assignedToId])
  @@index([category])
}

model TicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       MessageSender
  authorUserId String
  authorUser   User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime      @default(now())
}

model InternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model AiCallLog {
  id           String     @id @default(cuid())
  ticketId     String?
  ticket       Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  kind         AiCallKind
  model        String
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  success      Boolean
  errorCode    String?
  createdAt    DateTime   @default(now())
}
