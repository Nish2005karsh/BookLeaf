DATABASE_URL=postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15   # Neon POOLED url (runtime)
DIRECT_URL=postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require           # Neon DIRECT url (migrations)
TEST_DATABASE_URL=                                                                               # Neon branch for tests
JWT_SECRET=change-me-long-random
AI_PROVIDER=mock           # gemini | mock
GEMINI_API_KEY=              # from Google AI Studio (free tier)
AI_MODEL=gemini-2.5-flash    # current Flash/Flash-Lite model name from AI Studio
AI_TIMEOUT_MS=12000
AI_MAX_RPM=10
AI_DAILY_CALL_LIMIT=500
NEXT_PUBLIC_SHOW_DEMO_HINT=true
